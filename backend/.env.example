# App
APP_NAME=MedNarrate
APP_ENV=production
DEBUG=false
API_PREFIX=/api
FRONTEND_URL=https://your-frontend-domain.com
CORS_ORIGINS=https://your-frontend-domain.com

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:password123@localhost:5432/MEDNARRATEE
AUTO_CREATE_TABLES=true
PERSIST_RESULTS=true

# Auth
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
COOKIE_NAME=mednarrate_access
COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_DOMAIN=
CSRF_COOKIE_NAME=mednarrate_csrf

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL + pgvector hybrid RAG
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.42
RAG_MIN_LOCAL_CHUNKS=2
RAG_REPORT_MAX_CHUNKS=14
ONLINE_RAG_ENABLED=true
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=REPLACE_WITH_TAVILY_API_KEY
ONLINE_RAG_MAX_RESULTS=4
ONLINE_RAG_SEARCH_DEPTH=advanced
TRUSTED_MEDICAL_DOMAINS=medlineplus.gov,nih.gov,nlm.nih.gov,cdc.gov,who.int,nhs.uk,msdmanuals.com
DYNAMIC_KB_CACHE_ENABLED=true

# OCR / uploads
OCR_ENABLED=true
OCR_MIN_CONFIDENCE=0.45
OCR_PDF_DPI=180
MAX_PDF_OCR_PAGES=20
MAX_UPLOAD_MB=15
MAX_EXTRACTED_CHARS=80000
